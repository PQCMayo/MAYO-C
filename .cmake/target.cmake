if(${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm64" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "aarch64")
    add_definitions(-DTARGET_ARM64)
elseif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm")
    add_definitions(-DTARGET_ARM)
elseif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "x86_64")
    add_definitions(-DTARGET_AMD64)
elseif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "i386" OR ${CMAKE_SYSTEM_PROCESSOR} MATCHES "i686")
    add_definitions(-DTARGET_X86)
elseif(${CMAKE_SYSTEM_PROCESSOR} MATCHES "^(s390x.*|S390X.*)")
    add_definitions(-DTARGET_S390X)
    add_definitions(-DTARGET_BIG_ENDIAN)
else()
    add_definitions(-DTARGET_OTHER)
endif()

if (APPLE)
    add_definitions(-DTARGET_OS_MAC)
elseif (UNIX)
    add_definitions(-DTARGET_OS_UNIX)
else()
    add_definitions(-DTARGET_OS_OTHER)
endif()

set(G_C_OPT_FLAGS "")


if (DEFINED MAYO_MARCH)
  list(APPEND G_C_OPT_FLAGS
  ${MAYO_MARCH})
endif()

if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR (CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" AND ${CMAKE_SYSTEM_PROCESSOR} MATCHES "x86_64"))
  if (NOT DEFINED MAYO_MARCH)
    list(APPEND G_C_OPT_FLAGS
      -march=native)
  endif()
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64")
    option(ENABLE_AESNI "Use AESni" ON)
  endif()
elseif(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
  if (NOT DEFINED MAYO_MARCH)
    list(APPEND G_C_OPT_FLAGS
      -mcpu=apple-m1)
  endif()
  option(ENABLE_AESNI "Use AESni" OFF)
  option(ENABLE_AESNEON "Use AES-NEON" ON)
endif()

# MAYO_BUILD_TYPE picks the implementation: ref, opt (generic C), avx2, avx2_gfni,
# avx512_gfni (alias: gfni) or neon. Left unset (or "auto"), it is the fastest one the
# compiler can target with the flags above (-march=native unless MAYO_MARCH is given).
if (NOT DEFINED MAYO_BUILD_TYPE OR MAYO_BUILD_TYPE STREQUAL "auto")
  include(CheckCSourceCompiles)
  set(CMAKE_REQUIRED_FLAGS "${G_C_OPT_FLAGS}")
  string(REPLACE ";" " " CMAKE_REQUIRED_FLAGS "${CMAKE_REQUIRED_FLAGS}")
  # the result variables are cached, so key them on the flags: a new MAYO_MARCH re-checks
  string(MAKE_C_IDENTIFIER "${CMAKE_REQUIRED_FLAGS}" MAYO_FLAGS_ID)
  macro(mayo_have NAME CONDITION)
    check_c_source_compiles("#if !(${CONDITION})\n#error no\n#endif\nint main(void) { return 0; }" ${NAME}_${MAYO_FLAGS_ID})
    set(${NAME} ${${NAME}_${MAYO_FLAGS_ID}})
  endmacro()
  mayo_have(MAYO_HAVE_AVX512_GFNI "defined(__AVX512F__) && defined(__AVX512BW__) && defined(__GFNI__)")
  mayo_have(MAYO_HAVE_AVX2_GFNI "defined(__AVX2__) && defined(__GFNI__)")
  mayo_have(MAYO_HAVE_AVX2 "defined(__AVX2__)")
  mayo_have(MAYO_HAVE_NEON "defined(__ARM_NEON) && defined(__aarch64__)")
  unset(CMAKE_REQUIRED_FLAGS)
  if (MAYO_HAVE_AVX512_GFNI)
    set(MAYO_BUILD_TYPE avx512_gfni)
  elseif (MAYO_HAVE_AVX2_GFNI)
    set(MAYO_BUILD_TYPE avx2_gfni)
  elseif (MAYO_HAVE_AVX2)
    set(MAYO_BUILD_TYPE avx2)
  elseif (MAYO_HAVE_NEON)
    set(MAYO_BUILD_TYPE neon)
  else()
    set(MAYO_BUILD_TYPE opt)
  endif()
  message("MAYO_BUILD_TYPE not given: using ${MAYO_BUILD_TYPE}")
elseif (MAYO_BUILD_TYPE STREQUAL "gfni")
  set(MAYO_BUILD_TYPE avx512_gfni)
endif()

if (MAYO_BUILD_TYPE STREQUAL "ref")
  option(ENABLE_AESNI "Use AESni" OFF)
  option(ENABLE_PARAMS_DYNAMIC "Use dynamic parameters" ON)
  add_definitions(-DMAYO_BUILD_TYPE_REF)
elseif(MAYO_BUILD_TYPE STREQUAL "opt")
  add_definitions(-DMAYO_BUILD_TYPE_OPT)
  option(ENABLE_PARAMS_DYNAMIC "Use dynamic parameters" OFF)
elseif(MAYO_BUILD_TYPE STREQUAL "avx2")
  add_definitions(-DMAYO_BUILD_TYPE_AVX2)
  option(ENABLE_PARAMS_DYNAMIC "Use dynamic parameters" OFF)
elseif(MAYO_BUILD_TYPE STREQUAL "avx2_gfni")
  add_definitions(-DMAYO_BUILD_TYPE_AVX2_GFNI)
  option(ENABLE_PARAMS_DYNAMIC "Use dynamic parameters" OFF)
  list(APPEND G_C_OPT_FLAGS -mavx2 -mgfni)
elseif(MAYO_BUILD_TYPE STREQUAL "avx512_gfni")
  add_definitions(-DMAYO_BUILD_TYPE_AVX512_GFNI -DMAYO_GFNI_ZMM)
  option(ENABLE_PARAMS_DYNAMIC "Use dynamic parameters" OFF)
  list(APPEND G_C_OPT_FLAGS -mavx2 -mgfni -mavx512f -mavx512bw)
elseif(MAYO_BUILD_TYPE STREQUAL "neon")
  add_definitions(-DMAYO_BUILD_TYPE_NEON)
  option(ENABLE_PARAMS_DYNAMIC "Use dynamic parameters" OFF)
else()
  message(FATAL_ERROR "unknown MAYO_BUILD_TYPE ${MAYO_BUILD_TYPE}: use ref, opt, avx2, avx2_gfni, avx512_gfni, neon or auto")
endif()

separate_arguments(C_OPT_FLAGS UNIX_COMMAND "${G_C_OPT_FLAGS}")
